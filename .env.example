# AptJeeves — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real keys.

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Langfuse Observability ────────────────────────────────
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com

# ── AptJeeves Model & Backend Configuration ────────────────
APTJEEVES_LLM_PROVIDER=openai
APTJEEVES_LLM_MODEL=gpt-4.1-mini
APTJEEVES_EMBEDDING_MODEL=text-embedding-3-small
APTJEEVES_EXTRACTION_BACKEND=fake
APTJEEVES_EXTRACTION_MODEL=gpt-4.1-mini
APTJEEVES_INTENT_BACKEND=keyword
APTJEEVES_INTENT_MODEL=gpt-4.1-mini

# ── Data Paths ────────────────────────────────────────────
APTJEEVES_DB_PATH=aptjeeves.sqlite3
APTJEEVES_DATA_DIR=data

# ── Attachments (WhatsApp documents) ──────────────────────
# keep = retain original files in data/apartments/<slug>/attachments/
# delete_after_extract = remove a file once its text was extracted or it was skipped as sensitive
APTJEEVES_ATTACHMENT_RETENTION=keep
# APTJEEVES_ATTACHMENT_MAX_BYTES=20971520
# APTJEEVES_ATTACHMENT_MAX_PAGES=50
# APTJEEVES_ATTACHMENT_TIMEOUT_SECONDS=60
# Local-only OCR for images and scanned PDFs (pip install ".[ocr]"): none | local
APTJEEVES_ATTACHMENT_OCR_BACKEND=none
# APTJEEVES_ATTACHMENT_OCR_MIN_CONFIDENCE=0.6
# APTJEEVES_ATTACHMENT_OCR_MAX_PAGES=10
# APTJEEVES_ATTACHMENT_OCR_TIMEOUT_SECONDS=180
# APTJEEVES_ATTACHMENT_OCR_MIN_IMAGE_SIDE=200
# APTJEEVES_ATTACHMENT_OCR_MIN_TEXT_CHARS=30

# ── App Config ────────────────────────────────────────────
APTJEEVES_DEFAULT_TIMEZONE=Asia/Kolkata
APTJEEVES_LOG_LEVEL=INFO
